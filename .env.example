# Primary key. Can also live in your shell environment instead of this file.
CLAUDE_MYLOBSTER_KEY=sk-ant-...

# Fallback, used only when CLAUDE_MYLOBSTER_KEY is unset.
# ANTHROPIC_API_KEY=sk-ant-...

# Shared password gating the whole site. Leave unset locally to disable the
# gate; REQUIRED in production — without it anyone who finds the URL can
# trigger runs against your API key at roughly $7 each.
SITE_PASSWORD=

RATE_LIMIT_MAX=5
DATABASE_PATH=./data/reports.db

# Deployment only: the domain Caddy requests a TLS certificate for.
SITE_DOMAIN=checkcompetition.org
